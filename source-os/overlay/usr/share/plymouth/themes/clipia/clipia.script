W = Window.GetWidth(); H = Window.GetHeight();
Window.SetBackgroundTopColor(0.027, 0.043, 0.086);
Window.SetBackgroundBottomColor(0.10, 0.06, 0.28);
orbe_i = Image("orbe.png"); halo_i = Image("halo.png"); r1_i = Image("anneau1.png"); r2_i = Image("anneau2.png"); logo_i = Image("logo.png");
cx = W / 2; cy = H / 2 - 40;
halo = Sprite(halo_i); halo.SetX(cx - halo_i.GetWidth() / 2); halo.SetY(cy - halo_i.GetHeight() / 2); halo.SetZ(5);
orbe = Sprite(orbe_i); orbe.SetX(cx - orbe_i.GetWidth() / 2); orbe.SetY(cy - orbe_i.GetHeight() / 2); orbe.SetZ(10);
r1 = Sprite(r1_i); r1.SetZ(20); r2 = Sprite(r2_i); r2.SetZ(20);
logo = Sprite(logo_i); logo.SetX(cx - logo_i.GetWidth() / 2); logo.SetY(cy + 190); logo.SetZ(5);
t = 0;
fun refresh() {
  t++;
  halo.SetOpacity(0.65 + 0.35 * Math.Sin(t / 10));
  a = r1_i.Rotate(t * 0.04); r1.SetImage(a); r1.SetX(cx - a.GetWidth() / 2); r1.SetY(cy - a.GetHeight() / 2);
  b = r2_i.Rotate(-t * 0.027 + 1.1); r2.SetImage(b); r2.SetX(cx - b.GetWidth() / 2); r2.SetY(cy - b.GetHeight() / 2);
}
Plymouth.SetRefreshFunction(refresh);
