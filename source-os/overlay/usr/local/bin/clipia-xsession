#!/bin/bash
# Session de bureau Clipia OS (Xfce) : Clipia démarre dans sa fenêtre, à côté des autres applications.
xset s off -dpms 2>/dev/null
[ -f /etc/default/keyboard ] && . /etc/default/keyboard; setxkbmap "${XKBLAYOUT:-fr}" 2>/dev/null
export XDG_CURRENT_DESKTOP=XFCE GSK_RENDERER=cairo
exec dbus-run-session -- startxfce4
