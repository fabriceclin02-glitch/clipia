#!/bin/bash
# Au démarrage de la session : visite de bienvenue (une seule fois) ou assistant d'installation (entrée « Installer » du menu).
for i in $(seq 1 90); do curl -fs -m 5 http://127.0.0.1:8787/api/auto >/dev/null 2>&1 && break; sleep 1; done
export GSK_RENDERER=cairo GDK_BACKEND=x11 WEBKIT_DISABLE_COMPOSITING_MODE=1 WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1
U=http://127.0.0.1:8787/os.html
if grep -qw clipia.installer=1 /proc/cmdline; then page="#/installer"
elif [ ! -e /var/lib/clipia/data/os-bienvenue.ok ]; then page="#/bienvenue"
else exit 0; fi
sleep 8
exec epiphany --new-window "$U$page"
