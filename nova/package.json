{
  "name": "clipia-nova",
  "productName": "Clipia Nova",
  "version": "2.5.0",
  "description": "Clipia Nova — le navigateur compagnon CLENDAX : IA vocale, mode Tor, sécurité d'abord",
  "author": {
    "name": "Clin Fabrice — CLENDAX",
    "email": "fabriceclin02@gmail.com"
  },
  "homepage": "https://fabriceclin02-glitch.github.io/clipia/nova.html",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.clendax.clipianova",
    "productName": "Clipia Nova",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "system.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "tor",
        "to": "tor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "icon": "build/icon.png",
    "publish": null,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Clipia Nova",
      "artifactName": "Clipia-Nova-Windows-Installation.${ext}"
    },
    "portable": {
      "artifactName": "Clipia-Nova-Windows-Portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "Clipia-Nova-Mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Clipia a besoin du micro pour vous écouter quand vous lui parlez."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "Clin Fabrice <fabriceclin02@gmail.com>",
      "artifactName": "Clipia-Nova-Linux-${arch}.${ext}"
    }
  }
}
