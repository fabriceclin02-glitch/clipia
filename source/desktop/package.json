{
  "name": "clipia-desktop",
  "productName": "Clipia",
  "version": "1.0.0",
  "description": "Clipia — Studio créatif IA (CLENDAX)",
  "main": "main.js",
  "author": { "name": "Clin Fabrice — CLENDAX", "email": "fabriceclin02@gmail.com" },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis portable",
    "build:mac": "electron-builder --mac dmg zip",
    "build:linux": "electron-builder --linux AppImage deb",
    "build:all": "electron-builder -mwl"
  },
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "app.clendax.clipia",
    "productName": "Clipia",
    "directories": { "output": "dist", "buildResources": "resources" },
    "files": ["main.js", "preload.js", "resources/**/*"],
    "extraResources": [
      { "from": "../server", "to": "app/server" },
      { "from": "../web", "to": "app/web" },
      { "from": "../package.json", "to": "app/package.json" },
      { "from": "../.env.example", "to": "app/.env.example" }
    ],
    "win": { "target": ["nsis", "portable"], "icon": "resources/icone.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true, "shortcutName": "Clipia" },
    "mac": { "target": ["dmg", "zip"], "icon": "resources/icone.icns",
      "category": "public.app-category.music", "hardenedRuntime": true,
      "entitlements": "resources/entitlements.plist" },
    "linux": { "target": ["AppImage", "deb"], "icon": "resources/icone.png", "category": "AudioVideo" }
  }
}
