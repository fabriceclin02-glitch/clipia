# ─────────────────────────────────────────────────────────────
#  CLIPIA — configuration. Copier en ".env" et remplir.
#  Aucune clé n'est jamais envoyée au navigateur : tout reste ici.
# ─────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
PUBLIC_URL=http://127.0.0.1:8787

# Clé maîtresse du coffre (générée automatiquement si vide).
# 64 caractères hexadécimaux. NE PAS PARTAGER.
CLIPIA_MASTER_KEY=

# Secret de signature des sessions (généré si vide)
CLIPIA_JWT_SECRET=

# ── Fournisseurs IA cloud (tous facultatifs) ─────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
