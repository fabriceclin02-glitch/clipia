{
  "id": "/clipia/app/",
  "name": "Clipia — Studio créatif IA",
  "short_name": "Clipia",
  "description": "Clipia, l'assistant et studio créatif IA de CLENDAX. Conversation vocale naturelle, création et projets, directement sur votre téléphone.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#080a1c",
  "theme_color": "#080a1c",
  "categories": ["productivity", "utilities", "entertainment"],
  "icons": [
    { "src": "icones/clipia-64.png", "sizes": "64x64", "type": "image/png" },
    { "src": "icones/clipia-96.png", "sizes": "96x96", "type": "image/png" },
    { "src": "icones/clipia-144.png", "sizes": "144x144", "type": "image/png" },
    { "src": "icones/clipia-180.png", "sizes": "180x180", "type": "image/png" },
    { "src": "icones/clipia-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icones/clipia-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icones/clipia-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Parler à Clipia",
      "short_name": "Parler",
      "url": "./?action=voix",
      "icons": [{ "src": "icones/clipia-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Nouvelle conversation",
      "short_name": "Nouveau",
      "url": "./?action=nouveau",
      "icons": [{ "src": "icones/clipia-192.png", "sizes": "192x192" }]
    }
  ]
}
